<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DRPC.Client</id>
    <version>3.2.0</version>
    <authors>BIGSUNGG</authors>
    <readme>README.md</readme>
    <projectUrl>https://github.com/BIGSUNGG/DS_RPC</projectUrl>
    <description>Client-side runtime for DRPC — a distributed RPC library for .NET that runs over reliable UDP. Provides the client hub: connect over RUDP with connection keys and handshake timeouts, optionally wrapped in DTLS 1.2 packet encryption with hostname matching and certificate-pin validation, then invoke your contract through the typed await hub.MethodAsync(...) stubs emitted by DRPC.CodeGenerator — round-trip calls with per-call timeouts and cancellation, fire-and-forget one-way sends, and two-way callbacks from the server through the same stub pattern. Targets netstandard2.1, so it works from modern .NET apps and Unity 2021.2+ clients.</description>
    <repository type="git" url="https://github.com/BIGSUNGG/DS_RPC" commit="0224dc1a4cb6d609e6acf0bea39820b4bf6a4c93" />
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="DRPC.Shared" version="3.2.0" exclude="Build,Analyzers" />
        <dependency id="Communication.Network.RUDP.Client" version="2.5.1" exclude="Build,Analyzers" />
        <dependency id="Communication.Network.RUDP.Shared" version="2.5.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>