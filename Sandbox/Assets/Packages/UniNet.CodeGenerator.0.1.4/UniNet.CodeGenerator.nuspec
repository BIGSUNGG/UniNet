<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>UniNet.CodeGenerator</id>
    <version>0.1.4</version>
    <authors>DS</authors>
    <developmentDependency>true</developmentDependency>
    <description>Roslyn source generator for UniNet — scans NetworkBehaviour subclasses for [ServerRpc]/[ClientRpc]/[MulticastRpc]/[Replicated] members and emits DRPC hub wiring (typed stubs, incoming dispatch, replication delta handlers) against the DRPC runtime. Targets Roslyn 4.3 (Unity 6.0 LTS).</description>
