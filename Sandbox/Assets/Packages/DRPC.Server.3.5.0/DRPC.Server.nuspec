<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DRPC.Server</id>
    <version>3.5.0</version>
    <authors>BIGSUNGG</authors>
    <readme>README.md</readme>
    <projectUrl>https://github.com/BIGSUNGG/DS_RPC</projectUrl>
    <description>Server-side runtime for DRPC — a distributed RPC library for .NET that runs over reliable UDP. Provides the server hub and RUDP listener: accept connections gated by connection keys, cap pending and incoming work per hub, authorize requests through an override hook before method lookup, and enable optional DTLS 1.2 packet encryption with server certificates. Implement your contract via the generated partial {Method}_Implementation methods and call back into connected clients over the same typed stubs. Use it with DRPC.Shared to build real-time service backends for modern .NET and Unity 2021.2+ clients. Targets netstandard2.1.</description>
    <repository type="git" url="https://github.com/BIGSUNGG/DS_RPC" commit="f8f383105b494964b27b027406e2fa178a19b9fd" />
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="DRPC.Shared" version="3.5.0" exclude="Build,Analyzers" />
        <dependency id="Communication.Network.RUDP.Server" version="2.7.0" exclude="Build,Analyzers" />
        <dependency id="Communication.Network.RUDP.Shared" version="2.7.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>