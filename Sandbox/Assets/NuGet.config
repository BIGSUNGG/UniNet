<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- DS 로컬 NuGet 소스 — DRPC·MessageProtocol·Communication nupkg 보관 (프로젝트 루트 NuGet.config와 동일) -->
    <add key="unity-nuget" value="C:/Projects/DS/unity-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" enableCredentialProvider="false" />
  </packageSources>
  <disabledPackageSources />
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
  <config>
    <add key="packageInstallLocation" value="CustomWithinAssets" />
    <add key="repositoryPath" value="./Packages" />
    <add key="PackagesConfigDirectoryPath" value="." />
    <add key="slimRestore" value="false" />
    <add key="PreferNetStandardOverNetFramework" value="true" />
  </config>
</configuration>