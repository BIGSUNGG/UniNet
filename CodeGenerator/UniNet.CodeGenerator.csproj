<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>UniNet.CodeGenerator</PackageId>
    <Version>0.2.1</Version>
    <Authors>DS</Authors>
    <Description>Roslyn source generator for UniNet — scans NetworkBehaviour subclasses for [ServerRpc]/[ClientRpc]/[MulticastRpc]/[Replicated] members and emits DRPC hub wiring (typed stubs, incoming dispatch, replication delta handlers) against the DRPC runtime. Targets Roslyn 4.3 (Unity 6.0 LTS).</Description>
    <Tags>UniNet Roslyn SourceGenerator Analyzer DRPC Unity</Tags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GenDump/**" />
    <None Remove="GenDump/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
